<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
  <id>io.github.ariasmn.pidnl</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>pidnl</name>
  <summary>Limit network bandwidth per process</summary>

  <description>
    <p>
      pidnl sets per-process network bandwidth rate limits. Pick a running
      application and cap how much of your connection it is allowed to use.
    </p>
    <p>Features:</p>
    <ul>
      <li>Per-process upload and download rate limits</li>
      <li>Limits are removed automatically when a process exits</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.ariasmn.pidnl.desktop</launchable>

  <provides>
    <binary>pidnl</binary>
    <binary>pidnl-gui</binary>
  </provides>

  <categories>
    <category>System</category>
    <category>Monitor</category>
  </categories>

  <keywords>
    <keyword>bandwidth</keyword>
    <keyword>network</keyword>
    <keyword>limit</keyword>
    <keyword>throttle</keyword>
    <keyword>rate</keyword>
    <keyword>traffic</keyword>
  </keywords>

  <url type="homepage">https://github.com/ariasmn/pidnl</url>
  <url type="bugtracker">https://github.com/ariasmn/pidnl/issues</url>

  <developer id="io.github.ariasmn">
    <name>Ismael Arias</name>
  </developer>

  <content_rating type="oars-1.1" />

